{
  "name": "gastportal",
  "version": "0.5.0",
  "description": "Lokal gästportal – direkta bridge-API:er utan Home Assistant",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names SERVER,CLIENT --prefix-colors magenta,cyan \"npm run server\" \"npm run client\"",
    "dev:clean": "RESET=true npm run dev",
    "server": "node --watch server/index.js",
    "client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix client",
    "discover": "node scripts/discover.js",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "graphify": ".venv/bin/python3 -m graphify . --exclude '*.md' --exclude '*.png' --exclude 'graphify/*' --exclude 'graphify_temp/*' --exclude 'client/dist/*' --exclude 'client/index.html' --exclude 'docker-compose.yml' && .venv/bin/python3 -m graphify export wiki",
    "graphify:update": ".venv/bin/python3 -m graphify update . && .venv/bin/python3 -m graphify export wiki",
    "graphify:full": ".venv/bin/python3 -m graphify . && .venv/bin/python3 -m graphify export wiki"
  },
  "dependencies": {
    "@project-chip/matter-node.js": "^0.12.6",
    "@project-chip/matter.js": "^0.12.6",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.6.2",
    "node-tradfri-client": "^3.2.0",
    "socket.io": "^4.7.5",
    "undici": "^6.19.2"
  }
}
