# ============================================================
#  Miljövariabler – Gästportal (bridge-läge)
#  Kopiera till .env: cp .env.example .env
# ============================================================

# ── Philips Hue Bridge ──────────────────────────────────────
# IP-adress till din Hue Bridge (hitta i Hue-appen → Inställningar → Mina Hue-system)
HUE_BRIDGE_IP=192.168.1.XX

# API-nyckel (genereras automatiskt via: npm run discover)
HUE_API_KEY=

# ── IKEA Dirigera Hub ───────────────────────────────────────
# IP-adress till din Dirigera Hub (hitta i IKEA Home Smart-appen)
IKEA_HUB_IP=192.168.1.XX

# Access token (genereras via: npm run discover)
IKEA_TOKEN=

# ── Govee ───────────────────────────────────────────────────
# API-nyckel från Govee Developer Portal:
# https://developer.govee.com → Developer API Keys
GOVEE_API_KEY=

# ── Server ──────────────────────────────────────────────────
PORT=3001

# Administratörslösenord för inställningar / Setup Wizard
ADMIN_PASSWORD=1234
